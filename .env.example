# ─────────────────────────────────────────────
# Lumina Beauty – Environment Variables Template
# ─────────────────────────────────────────────
# Copy this file to .env for local development:
#   cp .env.example .env
# Then fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# MongoDB Atlas clustered connection string
# Your cluster: my-auth.i4nvqtt.mongodb.net
# Replace <password> with your my-auth-server user password from Atlas
MONGO_URI=mongodb+srv://my-auth-server:<password>@my-auth.i4nvqtt.mongodb.net/lumina_beauty?retryWrites=true&w=majority

# Name of the MongoDB database
DATABASE_NAME=lumina_beauty

# Flask secret key – generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_flask_secret_key_here

# Flask environment: development | production
FLASK_ENV=development

# Port the backend listens on locally (Render injects $PORT automatically in production)
PORT=5000
